      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        576,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "const log = $input.first().json.stdout;\n\nconst linhasFiltradas = log\n  .split('\\n')\n  .filter(linha => \n    linha.includes('500') ||\n    linha.includes('error') ||\n    linha.includes('timeout') ||\n    linha.includes('warning')\n  )\n  .slice(0, 50);\n\nreturn [{\n  json: {\n    logs_filtrados: linhasFiltradas.join('\\n')\n  }\n}];"
      },
      "id": "2ffe91d2-8e75-4ede-b8ed-297f1d3f04b9",
      "name": "Filtrar Logs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        576
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer minha_chave_que_nao_tenho"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Você é um analista DevOps especializado em logs Apache e WordPress.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analise os logs abaixo e identifique possíveis problemas, erros críticos e recomendações:\n\n{{$json.logs_filtrados}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "2319f238-1df5-4d4b-a51e-e2410d1d19c9",
      "name": "Analisar com IA",

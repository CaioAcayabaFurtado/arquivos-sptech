      "typeVersion": 4.2,
      "position": [
        1360,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "const resposta = $input.first().json.choices[0].message.content;\n\nreturn [{\n  json: {\n    texto: resposta\n  }\n}];"
      },
